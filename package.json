{
  "name": "highlands-btl2",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db:up": "node scripts/docker.mjs compose up -d --wait mysql",
    "db:down": "node scripts/docker.mjs compose down",
    "db:init": "node scripts/database.mjs init",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:update": "node scripts/database.mjs update",
    "db:check": "node scripts/database.mjs check",
    "test:db:fresh": "node docs/testing/check-fresh-database.mjs",
    "test:migration": "node docs/testing/check-migration.mjs",
    "test:integration": "node docs/testing/check-integration.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix highlands-server run build && npm --prefix highlands-client run build",
    "test": "npm --prefix highlands-server test -- --runInBand"
  },
  "engines": { "node": ">=24" }
}
